# PostgreSQL connection string used by SQLAlchemy's async engine (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app_db

# Enables debug mode (SQL echo, FastAPI debug) — set to false in production
DEBUG=true

# Origins allowed by CORS middleware: a JSON list or comma-separated; "*" is rejected
ALLOWED_ORIGINS=["http://localhost:3000"]

# Secret key used to sign JWT access tokens — generate one with: openssl rand -hex 32
SECRET_KEY=changeme

# Whether POST /auth/register is open — false on the hosted instance, set true when self-hosting for your own testing
ALLOW_REGISTRATION=false

# Which storage backend to use for uploaded scripts — see app/services/storage/registry.py
STORAGE_BACKEND=local

# Root directory the local storage backend saves uploaded scripts under
STORAGE_LOCAL_ROOT=./uploads

# Days an uploaded script is kept before deletion
FILE_RETENTION_DAYS=90

# Maximum accepted upload size in bytes (default 20MB)
MAX_UPLOAD_BYTES=20971520

# Which OCR engine extracts text from uploaded scripts — see app/services/ocr/registry.py
OCR_ENGINE=stub

# Claude model used by the claude OCR engine
OCR_MODEL=claude-sonnet-4-5

# Directory of mark scheme YAML files used for deterministic grading
MARK_SCHEMES_DIR=./mark_schemes

# Anthropic API key for LLM grading — leave unset to disable the /grade/llm endpoint
ANTHROPIC_API_KEY=

# Claude model used by the LLM grader
LLM_GRADER_MODEL=claude-sonnet-4-5

# Sats reward ledger amounts
FEEDBACK_REWARD_SATS=100
SCHEME_REWARD_SATS=500

# Blink Lightning payouts — see docs/PAYOUTS.md before changing any of these.
# The default URL is STAGING: test sats only, no real money.
# Switching to https://api.blink.sv/graphql sends REAL BITCOIN from the wallet below.
BLINK_API_URL=https://api.staging.blink.sv/graphql
# Blink API key — never commit a real one. A mainnet key with write permission can spend the wallet's balance.
BLINK_API_KEY=
# The BTC wallet payouts are sent from
BLINK_WALLET_ID=
# Master switch: nothing is sent unless this is true
PAYOUTS_ENABLED=false
